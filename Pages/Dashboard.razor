@page "/"

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Dashboard</MudText>

<MudGrid>
    @foreach (var kpi in kpis)
    {
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.subtitle2">@kpi.Titulo</MudText>
                    <MudIcon Icon="@kpi.Icone" Color="@kpi.Cor" />
                </div>
                <MudText Typo="Typo.h5">@kpi.Valor</MudText>
                <MudText Typo="Typo.caption" Color="@(kpi.Variacao >= 0 ? Color.Success : Color.Error)">
                    @(kpi.Variacao >= 0 ? "+" : "")@kpi.Variacao% este mês
                </MudText>
                <MudChart T="double" ChartType="ChartType.Line" Width="100%" Height="60px"
                          ChartSeries="@(new List<ChartSeries<double>> { new() { Name = kpi.Titulo, Data = kpi.Tendencia } })"
                          ChartLabels="semLabels" ChartOptions="opcoesMiniGrafico" />
            </MudPaper>
        </MudItem>
    }
    
        <MudItem xs="12" md="8">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Receita x Meta</MudText>
            <MudChart T="double" ChartType="ChartType.Line" ChartSeries="receitaMeta" ChartLabels="meses" Width="100%" Height="300px" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Distribuição de Clientes</MudText>
            <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="clientes" ChartLabels="tiposClientes" Width="220px" Height="220px" />
        </MudPaper>
    </MudItem>

        <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Performance dos Projetos</MudText>
            @foreach (var projeto in performance)
            {
                <div class="d-flex justify-space-between">
                    <MudText Typo="Typo.body2">@projeto.Nome</MudText>
                    <MudText Typo="Typo.body2">@projeto.Progresso%</MudText>
                </div>
                <MudProgressLinear Value="@projeto.Progresso" Color="@projeto.Cor" Rounded="true" Class="mb-4" />
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Atividades Recentes</MudText>
            <MudList T="string" Dense="true">
                @foreach (var atividade in atividades)
                {
                    <MudListItem T="string" Icon="@atividade.Icone">
                        <MudText Typo="Typo.body2">@atividade.Texto</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@atividade.Quando</MudText>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    </MudItem>

        <MudItem xs="12">
        <MudTable Items="projetosRecentes" Hover="true">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Projetos Recentes</MudText>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Projeto</MudTh>
                <MudTh>Cliente</MudTh>
                <MudTh>Responsável</MudTh>
                <MudTh>Prazo</MudTh>
                <MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Projeto">@context.Nome</MudTd>
                <MudTd DataLabel="Cliente">@context.Cliente</MudTd>
                <MudTd DataLabel="Responsável">@context.Responsavel</MudTd>
                <MudTd DataLabel="Prazo">@context.Prazo</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@CorDoStatus(context.Status)">@context.Status</MudChip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudItem>
</MudGrid>

@code {
    record Kpi(string Titulo, string Valor, double Variacao, string Icone, Color Cor, double[] Tendencia);

    List<Kpi> kpis = new()
    {
        new Kpi("Alunos ativos", "12.480", 8.2, Icons.Material.Filled.School, Color.Primary, new double[] { 10, 11, 11.5, 12, 12.2, 12.5 }),
        new Kpi("Receita", "R$ 1,2 mi", 5.4, Icons.Material.Filled.AttachMoney, Color.Success, new double[] { 900, 950, 1000, 1080, 1150, 1200 }),
        new Kpi("Projetos", "38", -2.1, Icons.Material.Filled.Folder, Color.Warning, new double[] { 42, 41, 40, 40, 39, 38 }),
        new Kpi("Satisfação", "94%", 1.3, Icons.Material.Filled.ThumbUp, Color.Info, new double[] { 90, 91, 92, 92, 93, 94 }),
    };

    string[] semLabels = { "", "", "", "", "", "" };

    LineChartOptions opcoesMiniGrafico = new() { ShowLegend = false, XAxisLines = false, YAxisLines = false };

        string[] meses = { "Jan", "Fev", "Mar", "Abr", "Mai", "Jun" };

    List<ChartSeries<double>> receitaMeta = new()
    {
        new ChartSeries<double> { Name = "Receita", Data = new double[] { 900, 950, 1000, 1080, 1150, 1200 } },
        new ChartSeries<double> { Name = "Meta", Data = new double[] { 1000, 1000, 1050, 1050, 1100, 1100 } },
    };

    List<ChartSeries<double>> clientes = new()
    {
        new ChartSeries<double> { Name = "Clientes", Data = new double[] { 45, 25, 20, 10 } },
    };
    string[] tiposClientes = { "Universidades", "Faculdades", "Escolas técnicas", "Outros" };

        record ProjetoPerformance(string Nome, int Progresso, Color Cor);
    record Atividade(string Texto, string Quando, string Icone);

    List<ProjetoPerformance> performance = new()
    {
        new ProjetoPerformance("Plataforma EAD", 80, Color.Primary),
        new ProjetoPerformance("Banco de Questões", 95, Color.Success),
        new ProjetoPerformance("App do Aluno", 50, Color.Info),
        new ProjetoPerformance("Portal do Professor", 30, Color.Warning),
    };

    List<Atividade> atividades = new()
    {
        new Atividade("Ana publicou um novo módulo", "há 5 min", Icons.Material.Filled.Publish),
        new Atividade("Bruno concluiu o Banco de Questões", "há 1 h", Icons.Material.Filled.CheckCircle),
        new Atividade("Carla adicionou um novo cliente", "há 3 h", Icons.Material.Filled.PersonAdd),
        new Atividade("Diego gerou o relatório mensal", "ontem", Icons.Material.Filled.Description),
    };

    record ProjetoRecente(string Nome, string Cliente, string Responsavel, string Prazo, string Status);

    List<ProjetoRecente> projetosRecentes = new()
    {
        new ProjetoRecente("Plataforma EAD", "Universidade Alfa", "Ana", "15/11/2026", "Em andamento"),
        new ProjetoRecente("Banco de Questões", "Faculdade Beta", "Bruno", "30/09/2026", "Concluído"),
        new ProjetoRecente("App do Aluno", "Escola Técnica Gama", "Carla", "20/12/2026", "Em andamento"),
        new ProjetoRecente("Portal do Professor", "Universidade Delta", "Diego", "10/10/2026", "Atrasado"),
    };

    Color CorDoStatus(string status) => status switch
    {
        "Concluído" => Color.Success,
        "Em andamento" => Color.Info,
        "Atrasado" => Color.Error,
        _ => Color.Default,
    };
}